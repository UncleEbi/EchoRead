{
  "manifest_version": 3,
  "name": "EchoRead",
  "version": "1.1.0",
  "description": "Read any article aloud with text-to-speech, and highlight & save snippets from any webpage.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tts"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "EchoRead",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}